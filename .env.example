# Copy to .env once. Keep keys on the server. Restart npm start after edits.
# Switch AI_PROVIDER only after filling the corresponding provider's key below.
# Supported: deepseek | openai | gemini | compatible
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Search is independent of the writing model: exa | tavily | openai | manual
# Exa is the recommended source-discovery provider for this project.
# Without a search key you can still add public source URLs manually.
SEARCH_PROVIDER=exa
EXA_API_KEY=
TAVILY_API_KEY=

# Optional alternatives. Only the selected provider receives its own key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_SEARCH_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Custom OpenAI-compatible Chat Completions endpoint, e.g. a gateway.
# Base URL includes its API prefix (often /v1), NOT /chat/completions.
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_MODEL=
# json_object | json_schema | text (local schema/citation validation always runs)
COMPATIBLE_JSON_MODE=json_object
PORT=3000
