{
  "name": "scriptforge-c3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --env-file-if-exists=.env codebase/server.js",
    "dev": "node --env-file-if-exists=.env --watch codebase/server.js",
    "test": "node --test codebase/tests/*.test.js",
    "eval": "node codebase/eval.js",
    "doctor": "node --env-file-if-exists=.env codebase/doctor.js",
    "check:api": "node --env-file-if-exists=.env codebase/doctor.js --live",
    "check:search": "node --env-file-if-exists=.env codebase/doctor.js --search"
  },
  "dependencies": { "cheerio": "1.2.0", "robots-parser": "3.0.1" }
}
